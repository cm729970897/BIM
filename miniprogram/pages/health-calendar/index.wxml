<view class="container theme-{{themeKey}}">
  <view class="goal-card" wx:if="{{goal}}">
    <view class="goal-head">
      <text class="goal-title">目标 {{goal.target}} kg</text>
      <text class="goal-date">{{goal.targetDate}}</text>
    </view>
    <view class="progress-bar"><view class="progress-fill" style="width: {{goalProg}}%"></view></view>
    <text class="goal-sub">已完成 {{goalProg}}% · 距目标 {{diff}} kg</text>
  </view>

  <view class="section-title">健康日历</view>
  <health-calendar value="{{selectedDate}}" marked="{{markedDates}}" bindchange="onCalendarChange" />

  <view class="day-card" wx:if="{{dayData}}">
    <view class="day-head">
      <text class="day-title">{{dayData.date}} 健康记录</text>
      <text class="day-badge" wx:if="{{dayData.hasAny}}">有记录</text>
    </view>

    <view class="empty" wx:if="{{!dayData.hasAny}}">这一天还没有体重、饮食或运动记录。</view>

    <view wx:else>
      <view class="record-block">
        <view class="record-title">体重与 BMI</view>
        <view class="record-row" wx:if="{{dayData.weight}}">
          <text>体重</text><text>{{dayData.weight.weight}} kg</text>
        </view>
        <view class="record-row" wx:if="{{dayData.bmi}}">
          <text>BMI</text><text>{{dayData.bmi}}（{{dayData.bmiStatus}}）</text>
        </view>
        <view class="record-empty" wx:if="{{!dayData.weight}}">当天暂无体重记录</view>
      </view>

      <view class="record-block">
        <view class="record-title">饮食</view>
        <view class="record-row" wx:if="{{dayData.diets.length}}">
          <text>总热量</text><text>{{dayData.dietKcal}} kcal</text>
        </view>
        <view class="record-line" wx:for="{{dayData.diets}}" wx:key="index">
          <text>{{item.meal || '一餐'}}</text><text>{{item.totalKcal || 0}} kcal</text>
        </view>
        <view class="record-empty" wx:if="{{!dayData.diets.length}}">当天暂无饮食记录</view>
      </view>

      <view class="record-block">
        <view class="record-title">运动</view>
        <view class="record-row" wx:if="{{dayData.exercises.length}}">
          <text>合计</text><text>{{dayData.exerciseMin}} 分钟 · {{dayData.exerciseKcal}} kcal</text>
        </view>
        <view class="record-line" wx:for="{{dayData.exercises}}" wx:key="index">
          <text>{{item.name || item.type || '运动'}}</text><text>{{item.duration || 0}} 分钟</text>
        </view>
        <view class="record-empty" wx:if="{{!dayData.exercises.length}}">当天暂无运动记录</view>
      </view>
    </view>
  </view>
</view>