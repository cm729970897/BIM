.container { padding: 24rpx 24rpx 40rpx; }

.goal-card { background: #fff; border-radius: 20rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: 0 4rpx 16rpx rgba(58,125,68,0.06); }
.goal-head { display: flex; justify-content: space-between; }
.goal-title { font-size: 28rpx; font-weight: 600; }
.goal-date { font-size: 22rpx; color: #999; }
.progress-bar { height: 12rpx; background: #EEF3EE; border-radius: 8rpx; margin-top: 16rpx; overflow: hidden; }
.progress-fill { height: 12rpx; background: linear-gradient(90deg, #3A7D44, #6DB33F); border-radius: 8rpx; transition: width 0.4s; }
.goal-sub { font-size: 22rpx; color: #666; margin-top: 12rpx; }

.section-title { font-size: 28rpx; font-weight: 600; color: #333; margin: 20rpx 0 12rpx; }

.day-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-top: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(58,125,68,0.06);
}
.day-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.day-title { font-size: 28rpx; font-weight: 700; color: #1F4D2A; }
.day-badge { font-size: 22rpx; color: #3A7D44; background: #E8F3E6; padding: 6rpx 14rpx; border-radius: 999rpx; }
.empty, .record-empty { font-size: 24rpx; color: #999; line-height: 1.6; background: #F7FAF6; border-radius: 16rpx; padding: 20rpx; }
.record-block { border-top: 1rpx solid #EEF3EE; padding-top: 18rpx; margin-top: 18rpx; }
.record-block:first-child { border-top: 0; padding-top: 0; margin-top: 0; }
.record-title { font-size: 26rpx; font-weight: 600; color: #333; margin-bottom: 12rpx; }
.record-row, .record-line { display: flex; justify-content: space-between; align-items: center; font-size: 24rpx; color: #666; padding: 8rpx 0; }
.record-row text:last-child, .record-line text:last-child { color: #1F4D2A; font-weight: 600; }