.range-scroll { white-space: nowrap; margin-bottom: 16rpx; }
.range-chip { display: inline-flex; align-items: center; padding: 12rpx 28rpx; margin-right: 16rpx; border-radius: 30rpx; background: #F1F5F1; color: #666; font-size: 26rpx; }
.range-chip.on { background: #3A7D44; color: #fff; font-weight: 600; }
.custom-range-line {
  display: flex;
  align-items: center;
  min-height: 72rpx;
  margin: 0 0 20rpx;
  padding: 0 10rpx 0 22rpx;
  box-sizing: border-box;
  background: #FFFFFF;
  border: 1rpx solid #E5E5EA;
  border-radius: 18rpx;
  box-shadow: 0 2rpx 8rpx rgba(28, 28, 30, .04);
}
.custom-label {
  flex: 0 0 auto;
  margin-right: 12rpx;
  color: #3C3C43;
  font-size: 26rpx;
  font-weight: 500;
}
.custom-days {
  flex: 0 0 132rpx;
  width: 132rpx;
  height: 52rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  color: #1C1C1E;
  background: #F2F2F7;
  border-radius: 12rpx;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 52rpx;
  text-align: center;
}
.custom-unit {
  flex: 0 0 auto;
  margin: 0 18rpx 0 10rpx;
  color: #8E8E93;
  font-size: 26rpx;
}
.custom-apply {
  flex: 0 0 112rpx;
  width: 112rpx;
  height: 56rpx;
  margin: 0 0 0 auto;
  padding: 0;
  box-sizing: border-box;
  background: var(--accent-dark);
  color: #FFFFFF;
  border: none;
  border-radius: 14rpx;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 56rpx;
  box-shadow: none;
}
.custom-apply::after { border: none; }
.custom-apply:active { opacity: .86; }
.chart { width: 100%; height: 360rpx; margin-bottom: 16rpx; }
.kpi-row { display: flex; justify-content: space-around; padding: 12rpx 0; }
.kpi { text-align: center; }
.kpi .val { font-size: 32rpx; font-weight: 700; color: #1F4D2A; display: block; }
.kpi .lbl { font-size: 22rpx; color: #999; }
.trend-title { font-size: 26rpx; font-weight: 600; color: #333; margin-bottom: 12rpx; }
.tl-empty { text-align: center; color: #bbb; padding: 24rpx 0; font-size: 24rpx; }
.tl-item { display: flex; align-items: center; padding: 10rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.td { font-size: 24rpx; color: #999; width: 200rpx; }
.tv { font-size: 28rpx; color: #1F4D2A; font-weight: 600; flex: 1; }
.tbmi { font-size: 22rpx; color: #3A7D44; }
