<view class="container theme-{{themeKey}}"><view class="header">健康食谱</view><view class="tags"><view class="tag {{tag==='all'?'on':''}}" data-t="all" bindtap="setTag">全部</view><view class="tag {{tag==='lose'?'on':''}}" data-t="lose" bindtap="setTag">减脂</view><view class="tag {{tag==='breakfast'?'on':''}}" data-t="breakfast" bindtap="setTag">早餐</view><view class="tag {{tag==='protein'?'on':''}}" data-t="protein" bindtap="setTag">高蛋白</view><view class="tag {{tag==='low'?'on':''}}" data-t="low" bindtap="setTag">低热量</view><view class="tag {{tag==='quick'?'on':''}}" data-t="quick" bindtap="setTag">快手</view></view><view class="add-bar"><view class="tag add-btn" bindtap="openForm">+ 自定义食谱</view></view><view class="add-form" wx:if="{{showForm}}"><view class="form-title">添加自定义食谱</view><input class="form-input" placeholder="名称" data-k="name" bindinput="onInput" value="{{form.name}}"/><input class="form-input" type="number" placeholder="热量 (kcal)" data-k="kcal" bindinput="onInput" value="{{form.kcal}}"/><input class="form-input" type="digit" placeholder="蛋白质 (g)" data-k="protein" bindinput="onInput" value="{{form.protein}}"/><textarea class="form-area" placeholder="食材，每行一种" data-k="ingredients" bindinput="onInput" value="{{form.ingredients}}"/><textarea class="form-area" placeholder="制作步骤，每行一步" data-k="steps" bindinput="onInput" value="{{form.steps}}"/><view class="form-btns"><button class="btn-cancel" bindtap="closeForm">取消</button><button class="btn-save" bindtap="saveCustom">保存</button></view></view><view class="grid"><view class="recipe-card" wx:for="{{list}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}"><view class="r-img" style="background:#E8F3E6"><text class="r-emoji">🍱</text></view><view class="r-info"><text class="r-name">{{item.name}}</text><view class="r-tags"><text class="rt" wx:for="{{item.tags}}" wx:key="*this">{{item}}</text></view><view class="r-meta"><text>{{item.kcal}} kcal</text><text>蛋白质 {{item.protein}}g</text></view></view></view></view><view class="placeholder" wx:if="{{!list.length}}">暂无食谱</view></view>