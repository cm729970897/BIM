.container { padding: 24rpx 24rpx 56rpx; box-sizing: border-box; }

.section-title { font-size: 26rpx; font-weight: 600; color: #8E8E93; margin: 32rpx 8rpx 14rpx; letter-spacing: 0.3rpx; }

.preview-card {
  position: relative;
  height: 340rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #E8F3E6;
  box-shadow: 0 1rpx 2rpx rgba(0,0,0,0.03), 0 12rpx 30rpx rgba(31,77,42,0.14);
  border: 1rpx solid rgba(255,255,255,0.6);
}
.preview-inner { position: absolute; top: 0; left: 0; right: 0; bottom: 0; }
.preview-empty { display: flex; align-items: center; justify-content: center; color: #8E8E93; font-size: 26rpx; }
.preview-mask { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: linear-gradient(180deg, rgba(0,0,0,0) 40%, rgba(0,0,0,0.42) 100%); }
.preview-title { position: absolute; z-index: 2; bottom: 50rpx; left: 28rpx; color: #fff; font-size: 32rpx; font-weight: 700; }
.preview-tip { position: absolute; z-index: 2; bottom: 22rpx; left: 28rpx; color: rgba(255,255,255,0.85); font-size: 22rpx; }

.grid { display: flex; gap: 18rpx; }
.w-card {
  flex: 1;
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  border: 2rpx solid transparent;
  box-shadow: 0 1rpx 2rpx rgba(0,0,0,0.03), 0 6rpx 18rpx rgba(0,0,0,0.05);
}
.w-card.on { border-color: #3A7D44; }
.w-thumb { height: 180rpx; }
.w-foot { display: flex; align-items: center; justify-content: space-between; padding: 14rpx 16rpx; }
.w-name { font-size: 24rpx; color: #1C1C1E; font-weight: 500; }

.group {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 1rpx 2rpx rgba(0,0,0,0.03), 0 8rpx 24rpx rgba(0,0,0,0.05);
}
.c-item { display: flex; align-items: center; padding: 16rpx 20rpx; position: relative; }
.c-item + .c-item::before {
  content: '';
  position: absolute;
  left: 140rpx;
  right: 0;
  top: 0;
  height: 1rpx;
  background: #E5E5EA;
}
.c-thumb { width: 96rpx; height: 96rpx; border-radius: 14rpx; margin-right: 20rpx; background: #F2F5F2; }
.c-name { flex: 1; font-size: 28rpx; color: #1C1C1E; }
.c-del { font-size: 26rpx; color: #FF453A; padding: 8rpx 12rpx; }

.placeholder {
  text-align: center;
  color: #8E8E93;
  padding: 40rpx 24rpx;
  font-size: 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 1rpx 2rpx rgba(0,0,0,0.03), 0 8rpx 24rpx rgba(0,0,0,0.05);
}

.btn-add {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin-top: 20rpx;
  height: 88rpx;
  background: rgba(58,125,68,0.10);
  color: #3A7D44;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: 1rpx solid rgba(58,125,68,0.14);
}
.btn-add::after { border: none; }
.btn-add-text { margin-left: 12rpx; }

.row { display: flex; align-items: center; padding: 18rpx 20rpx; }
.label { flex: 1; font-size: 30rpx; color: #1C1C1E; margin-left: 20rpx; }
.val { font-size: 28rpx; color: #8E8E93; }

.ic {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
}

/* original CSS-drawn glyphs */
.ic-add { background: #3A7D44; }
.ic-add::before { content: ''; width: 22rpx; height: 3rpx; background: #fff; border-radius: 2rpx; }
.ic-add::after { content: ''; position: absolute; width: 3rpx; height: 22rpx; background: #fff; border-radius: 2rpx; }

.ic-clock { background: #5AC8FA; }
.ic-clock::before { content: ''; width: 24rpx; height: 24rpx; border: 3rpx solid #fff; border-radius: 50%; }
.ic-clock::after { content: ''; position: absolute; top: 50%; left: 50%; width: 3rpx; height: 10rpx; background: #fff; border-radius: 2rpx; transform-origin: bottom center; transform: translate(-50%, -100%) rotate(45deg); }
/* Image upload is an auxiliary action, so keep it small and quiet. */
.action-row { display: flex; justify-content: center; margin-top: 20rpx; }
.action-row .btn-add { display: inline-flex; width: auto; height: 58rpx; margin: 0; padding: 0 24rpx; border: none; border-radius: 16rpx; background: var(--accent-soft); color: var(--accent-dark); font-size: 25rpx; font-weight: 600; }
.action-row .ic { width: 34rpx; height: 34rpx; border-radius: 10rpx; }
.action-row .ic-add { background: var(--accent-dark); }
.action-row .ic-add::before { width: 14rpx; }
.action-row .ic-add::after { height: 14rpx; }
.action-row .btn-add-text { margin-left: 10rpx; }
.action-row { justify-content: flex-end; }
/* Neutralise the prior broad upload declaration. */
.btn-add { width: auto; height: 58rpx; margin: 0; }