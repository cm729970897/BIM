.row { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.label { font-size: 28rpx; color: #666; width: 220rpx; }
.input { flex: 1; font-size: 28rpx; padding: 8rpx; border-bottom: 1rpx solid #eee; text-align: right; }
.chip { padding: 10rpx 28rpx; border-radius: 40rpx; background: #F1F5F1; margin-left: 16rpx; font-size: 26rpx; }
.chip.on { background: #3A7D44; color: #fff; }
.val { flex: 1; font-size: 28rpx; text-align: right; padding: 8rpx; border-bottom: 1rpx solid #eee; }
.title { font-size: 28rpx; font-weight: 600; margin-bottom: 12rpx; }
.calc-item { display: flex; align-items: center; padding: 10rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.cl { font-size: 26rpx; color: #666; width: 200rpx; }
.cv { font-size: 32rpx; font-weight: 700; color: #1F4D2A; width: 200rpx; }
.cs { font-size: 22rpx; color: #999; }
.action-row { display: flex; justify-content: center; margin-top: 24rpx; }
.action-row .btn-primary { width: auto; min-width: 132rpx; height: 58rpx; line-height: 58rpx; margin: 0; padding: 0 30rpx; border: none; border-radius: 16rpx; background: var(--accent-dark); color: #fff; font-size: 26rpx; font-weight: 600; box-shadow: none; }
/* Save actions follow the iOS trailing-action convention. */
.action-row { justify-content: flex-end; }