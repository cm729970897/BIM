<view class="container theme-{{themeKey}}"><view class="header">健康计算器</view><view class="card"><view class="row"><text class="label">身高（cm）</text><input class="input" type="number" value="{{height}}" bindinput="set" data-f="height"/></view><view class="row"><text class="label">体重（kg）</text><input class="input" type="number" value="{{weight}}" bindinput="set" data-f="weight"/></view><view class="row"><text class="label">年龄</text><input class="input" type="number" value="{{age}}" bindinput="set" data-f="age"/></view><view class="row"><text class="label">性别</text><view class="chip {{gender==='male'?'on':''}}" bindtap="setG" data-g="male">男</view><view class="chip {{gender==='female'?'on':''}}" bindtap="setG" data-g="female">女</view></view><view class="row"><text class="label">活动水平</text><picker mode="selector" range="{{acts}}" value="{{aIdx}}" bindchange="onAct"><text class="val">{{acts[aIdx]}}</text></picker></view></view><view class="card"><view class="title">计算结果</view><view class="calc-item"><text class="cl">BMI</text><text class="cv">{{preview.bmi || '--'}}</text><text class="cs">{{preview && preview.status}}</text></view><view class="calc-item"><text class="cl">基础代谢</text><text class="cv">{{preview.bmr || '--'}}</text><text class="cs">kcal</text></view><view class="calc-item"><text class="cl">每日消耗</text><text class="cv">{{preview.tdee || '--'}}</text><text class="cs">kcal</text></view><view class="calc-item"><text class="cl">建议热量</text><text class="cv">{{preview.cal || '--'}}</text><text class="cs">kcal</text></view></view><view class="action-row"><button class="btn-primary" bindtap="save">保存</button></view></view>
