.chat-wrap { display: flex; flex-direction: column; height: 100vh; background: #F6FAF6; }

.food-card { background: #fff; margin: 16rpx 20rpx 0; border-radius: 20rpx; padding: 20rpx; box-shadow: 0 4rpx 16rpx rgba(58,125,68,0.08); }
.food-title { font-size: 28rpx; font-weight: 700; color: #1F4D2A; margin-bottom: 14rpx; }
.food-row { display: flex; align-items: center; gap: 12rpx; }
.food-input { flex: 1; min-width: 0; height: 52rpx; line-height: 52rpx; padding: 0 18rpx; box-sizing: border-box; background: #F6FAF6; border-radius: 14rpx; font-size: 26rpx; }
.food-tip { font-size: 20rpx; color: #999; margin-top: 10rpx; }
.food-loading { font-size: 22rpx; color: #3A7D44; margin-top: 12rpx; }
.food-src { font-size: 20rpx; color: #888; margin-top: 12rpx; }
.food-results { margin-top: 14rpx; max-height: 320rpx; overflow-y: auto; }
.food-empty { font-size: 24rpx; color: #999; background: #F7FAF6; border-radius: 16rpx; padding: 24rpx; line-height: 1.6; }
.food-item { border-top: 1rpx solid #EEF3EE; padding: 16rpx 0; }
.food-item-head { display: flex; align-items: baseline; justify-content: space-between; }
.food-name { font-size: 28rpx; font-weight: 600; color: #333; }
.food-unit { font-size: 20rpx; color: #999; }
.food-meta { display: flex; margin-top: 12rpx; }
.fm { flex: 1; text-align: center; background: #F7FAF6; border-radius: 12rpx; padding: 12rpx 0; margin-right: 8rpx; }
.fm:last-child { margin-right: 0; }
.fm-v { display: block; font-size: 26rpx; font-weight: 700; color: #1F4D2A; }
.fm-l { font-size: 18rpx; color: #999; margin-top: 4rpx; }
.food-tags { display: flex; gap: 8rpx; flex-wrap: wrap; margin-top: 12rpx; }
.ftag { font-size: 20rpx; color: #3A7D44; background: #E8F3E6; padding: 3rpx 12rpx; border-radius: 8rpx; }

.chat-bar { padding: 16rpx 24rpx; background: #fff; border-bottom: 1rpx solid #EEF3EE; display: flex; align-items: center; }
.cb-title { font-size: 30rpx; font-weight: 700; color: #1F4D2A; flex: 1; }
.cb-sub { font-size: 20rpx; color: #999; margin-right: 16rpx; }
.cb-hist { font-size: 24rpx; color: #3A7D44; }
.chat-list { flex: 1; padding: 20rpx 24rpx; overflow-y: auto; }
.msg { display: flex; align-items: flex-start; margin-bottom: 20rpx; }
.avatar { width: 60rpx; height: 60rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 32rpx; margin-right: 16rpx; flex-shrink: 0; }
.avatar.user { background: #E8F3E6; }
.avatar.assistant { background: #3A7D44; }
.bubble { max-width: 70%; padding: 18rpx 22rpx; border-radius: 24rpx; font-size: 28rpx; line-height: 1.5; }
.bubble.user { background: #3A7D44; color: #fff; margin-left: 76rpx; border-top-right-radius: 6rpx; }
.bubble.assistant { background: #fff; color: #333; border-top-left-radius: 6rpx; }
.dot-anim { display: inline-flex; gap: 4rpx; margin-top: 8rpx; }
.dot-anim::before, .dot-anim::after { content: ''; width: 10rpx; height: 10rpx; border-radius: 50%; background: #3A7D44; display: inline-block; animation: blink 1s infinite; }
@keyframes blink { 50% { opacity: 0.3; } }

.quick-row { display: flex; gap: 10rpx; padding: 12rpx 24rpx; overflow-x: auto; }
.qchip { font-size: 22rpx; background: #fff; border: 1rpx solid #3A7D44; color: #3A7D44; padding: 8rpx 16rpx; border-radius: 20rpx; white-space: nowrap; flex-shrink: 0; }

.input-row { display: flex; align-items: center; gap: 12rpx; padding: 16rpx 24rpx; background: #fff; border-top: 1rpx solid #EEF3EE; }
.input { flex: 1; min-width: 0; height: 52rpx; line-height: 52rpx; padding: 0 18rpx; box-sizing: border-box; background: #F6FAF6; border-radius: 14rpx; font-size: 28rpx; }

/* Structured assistant replies: short, breathable reading rhythm. */
.bubble.assistant { padding: 20rpx 24rpx; box-shadow: 0 6rpx 18rpx rgba(31,77,42,.06); }
.reply-line { display: block; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; font-size: 27rpx; font-weight: 400; line-height: 1.72; color: #334238; letter-spacing: 0; }
.reply-line + .reply-line { margin-top: 8rpx; }
.reply-line:last-child { color: #879188; font-size: 23rpx; font-weight: 400; line-height: 1.6; margin-top: 14rpx; padding-top: 12rpx; border-top: 1rpx solid #EEF3EE; }
.theme-pink .food-title, .theme-pink .cb-title, .theme-pink .food-loading, .theme-pink .cb-hist, .theme-pink .ftag, .theme-pink .qchip { color: var(--accent-dark); }
.theme-pink .avatar.assistant, .theme-pink .bubble.user { background: var(--accent-dark); }
.theme-pink .qchip { border-color: var(--accent); }
.theme-pink .ftag { background: var(--accent-soft); }
/* Final compact actions: fixed-size flex children prevent button defaults filling a row. */
.food-row, .input-row { display: flex; align-items: center; gap: 12rpx; }
.food-row .food-input, .input-row .input { flex: 1; min-width: 0; }
.food-row .food-btn, .input-row .send {
  display: inline-flex;
  flex: 0 0 100rpx;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  min-width: 0;
  height: 52rpx;
  line-height: 52rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  white-space: nowrap;
  background: var(--accent-dark);
  color: #fff;
  border: none;
  border-radius: 14rpx;
  font-size: 25rpx;
  font-weight: 600;
  box-shadow: none;
}
.food-row .food-btn::after, .input-row .send::after { border: none; }
.food-row .food-btn:active, .input-row .send:active { background: var(--accent); opacity: .88; transform: scale(.98); }