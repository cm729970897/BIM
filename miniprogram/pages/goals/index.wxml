<view class="container theme-{{themeKey}}"><view class="header">我的目标</view><view class="card"><view class="row"><text>目标类型</text><view class="chip {{type==='lose'?'on':''}}" bindtap="setType" data-t="lose">减脂</view><view class="chip {{type==='maintain'?'on':''}}" bindtap="setType" data-t="maintain">维持</view><view class="chip {{type==='gain'?'on':''}}" bindtap="setType" data-t="gain">增肌</view></view><view class="row"><text>目标体重（kg）</text><input class="input" type="digit" value="{{target}}" bindinput="setTarget"/></view><view class="row"><text>目标日期</text><picker mode="date" value="{{targetDate}}" bindchange="setDate"><text>{{targetDate}}</text></picker></view></view><view class="action-row"><button class="btn-primary" bindtap="save">保存</button></view></view>
