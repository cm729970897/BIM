.container { padding: 24rpx 24rpx 48rpx; box-sizing: border-box; }
.bg-layer { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 0; }
.bg-img { width: 100%; height: 100%; }
.bg-mask { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(255,255,255,0.55); backdrop-filter: blur(6rpx); }
.page-content { position: relative; z-index: 1; }

.hero {
  background: linear-gradient(135deg, #3A7D44, #6DB33F);
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(58,125,68,0.22);
}
.avatar {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.22);
  flex-shrink: 0;
  margin-right: 24rpx;
  overflow: hidden;
}
.avatar::before {
  content: '';
  position: absolute;
  top: 24rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.95);
}
.avatar::after {
  content: '';
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 86rpx;
  height: 50rpx;
  border-radius: 86rpx 86rpx 0 0;
  background: rgba(255,255,255,0.95);
}
.hero-info { display: flex; flex-direction: column; min-width: 0; flex: 1; }
.pname { font-size: 36rpx; font-weight: 700; color: #fff; letter-spacing: 0.3rpx; }
.psub { font-size: 24rpx; color: rgba(255,255,255,0.9); margin-top: 8rpx; }

.stats-card {
  display: flex;
  background: rgba(255,255,255,0.9);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255,255,255,0.8);
  box-shadow: 0 1rpx 2rpx rgba(0,0,0,0.03), 0 8rpx 24rpx rgba(0,0,0,0.05);
  margin-bottom: 8rpx;
  overflow: hidden;
}
.st { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 28rpx 0; position: relative; }
.st + .st::before {
  content: '';
  position: absolute;
  left: 0;
  top: 24rpx;
  bottom: 24rpx;
  width: 1rpx;
  background: #E5E5EA;
}
.sv { font-size: 40rpx; font-weight: 700; color: #1C1C1E; font-variant-numeric: tabular-nums; }
.sl { font-size: 22rpx; color: #8E8E93; margin-top: 8rpx; }

.section-title { font-size: 26rpx; font-weight: 600; color: #8E8E93; margin: 32rpx 8rpx 14rpx; letter-spacing: 0.3rpx; }

.group {
  background: rgba(255,255,255,0.9);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255,255,255,0.8);
  box-shadow: 0 1rpx 2rpx rgba(0,0,0,0.03), 0 8rpx 24rpx rgba(0,0,0,0.05);
  overflow: hidden;
}
.mi { display: flex; align-items: center; padding: 22rpx 24rpx; position: relative; }
.mi + .mi::before {
  content: '';
  position: absolute;
  left: 100rpx;
  right: 0;
  top: 0;
  height: 1rpx;
  background: #E5E5EA;
}
.mi-hover { background: rgba(0,0,0,0.04); }
.ic {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
  position: relative;
}
.mt { flex: 1; font-size: 30rpx; color: #1C1C1E; }
.mr { font-size: 32rpx; color: #C7C7CC; margin-left: 8rpx; }

/* original CSS-drawn glyphs (no emoji, no brand assets) */
.ic-goals { background: #FF9F0A; }
.ic-goals::before { content: ''; width: 26rpx; height: 26rpx; border-radius: 50%; border: 5rpx solid #fff; }
.ic-goals::after { content: ''; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 8rpx; height: 8rpx; border-radius: 50%; background: #fff; }

.ic-calc { background: #5856D6; }
.ic-calc::before {
  content: '';
  width: 26rpx;
  height: 26rpx;
  background-image: radial-gradient(circle at 6.5rpx 6.5rpx, #fff 3rpx, transparent 3.5rpx);
  background-size: 13rpx 13rpx;
}

.ic-ach { background: #FFB340; }
.ic-ach::before { content: ''; width: 22rpx; height: 16rpx; background: #fff; border-radius: 4rpx 4rpx 10rpx 10rpx; }
.ic-ach::after { content: ''; position: absolute; bottom: 14rpx; left: 50%; transform: translateX(-50%); width: 14rpx; height: 4rpx; background: #fff; border-radius: 2rpx; }

.ic-bg { background: #34C759; }
.ic-bg::before { content: ''; position: absolute; left: 13rpx; bottom: 13rpx; width: 20rpx; height: 20rpx; border: 3rpx solid #fff; border-radius: 5rpx; }
.ic-bg::after { content: ''; position: absolute; right: 13rpx; top: 13rpx; width: 20rpx; height: 20rpx; background: #fff; border-radius: 5rpx; }

.ic-set { background: #8E8E93; }
.ic-set::before { content: ''; width: 28rpx; height: 3rpx; background: #fff; border-radius: 2rpx; box-shadow: 0 10rpx 0 #fff, 0 -10rpx 0 #fff; }
.ic-set::after { content: ''; position: absolute; left: 30rpx; top: 50%; transform: translateY(-50%); width: 9rpx; height: 9rpx; border-radius: 50%; background: #8E8E93; border: 2rpx solid #fff; box-sizing: border-box; }

.btn-logout {
  margin-top: 28rpx;
  background: rgba(255,255,255,0.9);
  backdrop-filter: blur(20rpx);
  color: #FF453A;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255,255,255,0.8);
  box-shadow: 0 1rpx 2rpx rgba(0,0,0,0.03), 0 8rpx 24rpx rgba(0,0,0,0.05);
}
.btn-logout::after { border: none; }
/* Destructive actions remain compact text controls, not full-width banners. */
.btn-logout { display: block; width: auto; min-width: 132rpx; height: 56rpx; line-height: 56rpx; margin: 24rpx 0 0 auto; padding: 0 26rpx; border-radius: 16rpx; font-size: 25rpx; font-weight: 600; box-shadow: none; }