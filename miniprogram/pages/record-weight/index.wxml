<view class="container theme-{{themeKey}}">
  <view class="record-center">
    <view class="rc-item {{activeRecord === 'weight' ? 'rc-on' : ''}}" bindtap="switchRecord" data-p="weight"><view class="rc-icon rc-scale"></view><text class="rc-text">记录体重</text></view>
    <view class="rc-item {{activeRecord === 'diet' ? 'rc-on' : ''}}" bindtap="switchRecord" data-p="diet"><view class="rc-icon rc-food"></view><text class="rc-text">记录饮食</text></view>
    <view class="rc-item {{activeRecord === 'exercise' ? 'rc-on' : ''}}" bindtap="switchRecord" data-p="exercise"><view class="rc-icon rc-run"></view><text class="rc-text">记录训练</text></view>
  </view>
  <block wx:if="{{activeRecord === 'weight'}}">
    <view class="record-card"><text class="title">记录今日体重</text><view class="weight-date-row"><view class="weight-input"><input type="digit" class="num" value="{{weight}}" bindinput="onWeight"/><text class="unit">kg</text></view><picker class="date-picker" mode="date" value="{{date}}" bindchange="onDate"><text class="d-val">{{date}}</text></picker></view><view class="bmi-box" wx:if="{{bmi != null}}"><text class="bmi-num">BMI {{bmi}}</text><text class="bmi-status">{{bmiStatus}}</text></view><view class="action-row"><button class="btn-submit" bindtap="submit">保存</button></view></view>
    <view class="bmi-ref-card"><text class="bmi-ref-title">BMI 标准范围</text><view class="bmi-bar-wrap"><view class="bmi-bar"><view class="bmi-seg seg-low" style="width:28%;"><text class="seg-label low">偏瘦</text></view><view class="bmi-seg seg-normal" style="width:34%;"><text class="seg-label normal">正常</text></view><view class="bmi-seg seg-over" style="width:25%;"><text class="seg-label over">超重</text></view><view class="bmi-seg seg-obese" style="width:13%;"><text class="seg-label obese">肥胖</text></view><view class="bmi-marker" wx:if="{{bmiPercent != null}}" style="left:{{bmiPercent}}%;"><view class="marker-dot"></view></view></view><view class="bmi-scale"><text class="scale-tick" style="left:28%;">18.5</text><text class="scale-tick" style="left:62%;">24</text><text class="scale-tick" style="left:87%;">28</text></view></view><view class="bmi-live" wx:if="{{bmi != null}}">当前 BMI {{bmi}}（{{bmiStatus}}）</view><text class="bmi-ref-note">以上分类仅供健康参考</text></view>
    <view class="section-title">历史记录</view><view class="list-card" wx:for="{{records}}" wx:key="date"><view class="row"><text class="col-date">{{item.date}}</text><view class="col-right"><text class="col-weight">{{item.weight}} kg</text><text class="col-bmi" wx:if="{{item.bmi}}">BMI {{item.bmi}}</text></view></view></view><view class="placeholder" wx:if="{{!records.length}}">暂无体重记录，快去记录吧</view>
  </block>
  <block wx:elif="{{activeRecord === 'diet'}}">
    <view class="diet-panel"><view class="diet-header">记录饮食</view><view class="diet-date-bar"><text>记录日期</text><picker mode="date" value="{{dietDate}}" bindchange="onDietDate"><view class="diet-date-val">{{dietDate}}</view></picker></view><view class="meal-tabs"><view class="meal {{meal==='breakfast'?'on':''}}" bindtap="pickMeal" data-m="breakfast">早餐</view><view class="meal {{meal==='lunch'?'on':''}}" bindtap="pickMeal" data-m="lunch">午餐</view><view class="meal {{meal==='dinner'?'on':''}}" bindtap="pickMeal" data-m="dinner">晚餐</view><view class="meal {{meal==='snack'?'on':''}}" bindtap="pickMeal" data-m="snack">加餐</view></view><view class="diet-card"><view class="diet-title">添加食物</view><view class="entry-row"><input class="entry-input food-name" value="{{foodName}}" bindinput="onFoodName" placeholder="食物名称，如：鸡蛋、米饭"/><input class="entry-input food-kcal" type="digit" value="{{foodKcal}}" bindinput="onFoodKcal" placeholder="每100克热量"/><button class="btn-add" bindtap="addFood">添加</button></view><view class="food-list" wx:if="{{foodResults.length}}"><view class="food-item" wx:for="{{foodResults}}" wx:key="name" bindtap="chooseFood" data-f="{{item}}"><text>{{item.name}}</text><text class="fmeta">{{item.kcal}} kcal / 100g</text></view></view><text class="entry-tip">可从建议中选择，也可直接填写名称和热量</text></view><view class="diet-card"><view class="diet-title">本餐已选</view><view class="sum-item" wx:for="{{selected}}" wx:key="index"><text class="sname">{{item.name}}</text><text class="sgram">{{item.grams}}g</text><text class="skcal">{{item.calcKcal}} kcal</text><text class="sdel" bindtap="delFood" data-i="{{index}}">删除</text></view><view class="placeholder" wx:if="{{!selected.length}}">还未选择食物，搜索或手动添加吧</view><view class="sum-row"><text>本餐热量合计</text><text class="total">{{totalKcal}} kcal</text></view></view><view class="action-row"><button class="diet-save" bindtap="submitDiet">保存</button></view><view class="diet-card"><view class="diet-title">历史记录</view><view class="day-item" wx:for="{{dietHistory}}" wx:key="index"><view class="day-head"><text class="day-date">{{item.date}} · {{item.mealLabel}}</text><text class="day-kcal">{{item.totalKcal}} kcal</text></view><view class="day-foods" wx:if="{{item.meals.length}}"><text class="day-food" wx:for="{{item.meals}}" wx:for-item="f" wx:key="index">{{f.name}} {{f.grams}}g</text></view></view><view class="placeholder" wx:if="{{!dietHistory.length}}">暂无饮食记录，快去记录吧</view></view></view>
  </block>
  <block wx:else>
    <view class="exercise-panel"><view class="exercise-header">记录运动</view><view class="exercise-card"><view class="exercise-row"><text>日期</text><picker mode="date" value="{{exerciseDate}}" bindchange="onExerciseDate"><text>{{exerciseDate}}</text></picker></view><view class="exercise-row"><text>运动类型</text><picker mode="selector" range="{{types}}" value="{{typeIdx}}" bindchange="onExerciseType"><text>{{types[typeIdx]}}（MET {{metText}}）</text></picker></view><view class="exercise-row"><text>运动名称</text><input class="exercise-input" value="{{exerciseName}}" bindinput="onExerciseField" data-f="exerciseName" placeholder="可选，默认用类型名"/></view><view class="exercise-row"><text>运动时长（分钟）</text><input class="exercise-input" type="number" value="{{duration}}" bindinput="onExerciseField" data-f="duration" placeholder="请输入分钟数"/></view><view class="exercise-row"><text>消耗热量</text><text class="exercise-kcal">{{kcal}} kcal</text></view></view><view class="exercise-hint" wx:if="{{kcalHint}}">{{kcalHint}}</view><view class="action-row"><button class="exercise-save" bindtap="submitExercise">保存</button></view><view class="exercise-summary">{{exerciseDate}} 训练：{{todayMin}} 分钟 · {{todayCal}} kcal</view><view class="section-title">历史记录</view><view class="exercise-list" wx:if="{{exerciseRecords.length}}"><view class="exercise-item" wx:for="{{exerciseRecords}}" wx:key="index"><view><text class="exercise-name">{{item.name}}</text><text class="exercise-meta">{{item.date}} · {{item.type}} · {{item.duration}} 分钟</text></view><text class="exercise-kcal">{{item.calories}} kcal</text></view></view><view class="placeholder" wx:else>暂无训练记录，快去记录吧</view></view>
  </block>
</view>
