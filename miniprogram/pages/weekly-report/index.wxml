<view class="container theme-{{themeKey}}"><view class="header">每周报告</view><view class="card" wx:if="{{report}}"><view class="period">{{report.period}}</view><view class="grid"><view class="cell"><text class="cv">{{report.weightDrop}} kg</text><text class="cl">体重变化</text></view><view class="cell"><text class="cv">{{report.dietKcal}}</text><text class="cl">饮食 kcal</text></view><view class="cell"><text class="cv">{{report.exerciseKcal}}</text><text class="cl">运动消耗</text></view><view class="cell"><text class="cv">{{report.exerciseDays}} 天</text><text class="cl">运动天数</text></view><view class="cell"><text class="cv">{{report.checkinDays}} 天</text><text class="cl">打卡天数</text></view></view></view><view class="card"><view class="title">本周建议</view><view class="tip" wx:for="{{report && report.suggestions}}" wx:key="*this"><text class="dot">•</text><text>{{item}}</text></view></view><view class="placeholder" wx:if="{{!report}}">暂无数据，下周再来吧...</view></view>
