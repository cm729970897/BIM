.period { font-size: 26rpx; color: #999; margin-bottom: 16rpx; }
.grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.cell { flex: 0 0 30%; background: #F6FAF6; border-radius: 16rpx; padding: 16rpx; text-align: center; }
.cv { font-size: 32rpx; font-weight: 700; color: #1F4D2A; display: block; }
.cl { font-size: 20rpx; color: #999; margin-top: 4rpx; }
.title { font-size: 28rpx; font-weight: 600; margin-bottom: 12rpx; }
.tip { display: flex; align-items: center; padding: 10rpx 0; font-size: 26rpx; color: #555; }
.dot { color: #6DB33F; margin-right: 12rpx; }
.placeholder { text-align: center; color: #999; padding: 60rpx 0; }
