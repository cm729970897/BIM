.container {
  padding: 32rpx 28rpx 60rpx;
  box-sizing: border-box;
}

.title-card {
  background: linear-gradient(135deg, #3A7D44, #6DB33F);
  border-radius: 24rpx;
  padding: 40rpx 28rpx 30rpx;
  color: #fff;
  margin-bottom: 24rpx;
}

.title { font-size: 38rpx; font-weight: 700; display: block; }
.subtitle { font-size: 24rpx; color: #eafff0; margin-top: 8rpx; display: block; opacity: 0.9; }

.form-card, .goal-card, .preview-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(58, 125, 68, 0.06);
}

.row { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; }
.label { font-size: 28rpx; color: #666; }

.input { font-size: 30rpx; text-align: right; flex: 1; margin-left: 24rpx; padding: 10rpx; border-bottom: 1rpx solid #eee; }

/* 性别：显眼、易点按的双选分段控件。 */
.gender-row, .goal-row { display: flex; gap: 16rpx; }
.row:first-child { gap: 14rpx; }
.row:first-child .label { margin-right: auto; }

.chip, .goal {
  padding: 12rpx 28rpx;
  border-radius: 40rpx;
  background: #F1F5F1;
  color: #666;
  font-size: 26rpx;
  text-align: center;
}
.row:first-child .chip {
  min-width: 108rpx;
  padding: 16rpx 22rpx;
  box-sizing: border-box;
  border: 2rpx solid #DCE7DE;
  border-radius: 18rpx;
  background: #F7FAF7;
  color: #59625B;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
}
/* WXML 使用 on，active 同时保留以兼容其他选项。 */
.chip.on, .chip.active, .goal.active {
  background: var(--accent-dark);
  border-color: var(--accent-dark);
  color: #fff;
  box-shadow: 0 6rpx 14rpx rgba(28, 28, 30, .12);
}
.row:first-child .chip.on::before {
  content: '✓';
  font-size: 22rpx;
  margin-right: 8rpx;
  font-weight: 700;
}

.picker { color: #333; font-size: 28rpx; padding: 10rpx; border-bottom: 1rpx solid #eee; margin-left: 24rpx; }

.preview-card {
  display: flex; align-items: center; justify-content: space-around;
}
.pv-label { font-size: 24rpx; color: #888; display: block; text-align: center; }
.pv-val { font-size: 40rpx; color: #1F4D2A; font-weight: 700; display: block; margin-top: 8rpx; text-align: center; }
.pv-sub { font-size: 22rpx; color: #3A7D44; display: block; text-align: center; margin-top: 4rpx; }
.divider { flex: 0 0 1rpx; height: 80rpx; background: #eee; margin: 0 20rpx; }

.btn-save {
  background: linear-gradient(135deg, #3A7D44, #6DB33F);
  color: #fff;
  border-radius: 40rpx;
  font-size: 32rpx;
  margin-top: 20rpx;
  height: 84rpx;
  line-height: 84rpx;
}
.btn-save[disabled] { opacity: 0.7; }

.optional { font-size: 20rpx; color: #9AA39B; font-weight: 400; }
.goal-tip { display: block; font-size: 23rpx; color: #889188; margin-top: 18rpx; line-height: 1.55; }
/* 粉色壁纸下让未选择态保持中性，已选择态随主题突出。 */
.theme-pink .row:first-child .chip { border-color: #EBC9D3; background: #FFF8FA; color: #76545E; }
.theme-pink .row:first-child .chip.on { background: var(--accent-dark); border-color: var(--accent-dark); color: #fff; }
/* Setup ends with a modest iOS-style text button. */
.action-row { display: flex; justify-content: center; margin-top: 24rpx; }
.action-row .btn-save { width: auto; min-width: 144rpx; height: 58rpx; line-height: 58rpx; margin: 0; padding: 0 30rpx; border: none; border-radius: 16rpx; background: var(--accent-dark); color: #fff; font-size: 26rpx; font-weight: 600; box-shadow: none; }
/* Save actions follow the iOS trailing-action convention. */
.action-row { justify-content: flex-end; }