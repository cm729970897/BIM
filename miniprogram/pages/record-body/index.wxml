<view class="container theme-{{themeKey}}"><view class="header">记录身体数据</view><view class="card"><view class="row"><text>日期</text><picker mode="date" value="{{date}}" bindchange="onDate"><text>{{date}}</text></picker></view><view class="row"><text>腰围（cm）</text><input class="input" type="digit" value="{{waist}}" bindinput="set" data-f="waist"/></view><view class="row"><text>臀围（cm）</text><input class="input" type="digit" value="{{hip}}" bindinput="set" data-f="hip"/></view><view class="row"><text>胸围（cm）</text><input class="input" type="digit" value="{{chest}}" bindinput="set" data-f="chest"/></view><view class="row"><text>大腿围（cm）</text><input class="input" type="digit" value="{{thigh}}" bindinput="set" data-f="thigh"/></view><view class="row"><text>体脂率（%）</text><input class="input" type="digit" value="{{bodyFat}}" bindinput="set" data-f="bodyFat"/></view></view><view class="action-row"><button class="btn-primary" bindtap="submit">保存</button></view></view>
