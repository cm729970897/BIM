.container { padding: 24rpx 24rpx 48rpx; box-sizing: border-box; }

.section-title { font-size: 26rpx; font-weight: 600; color: #8E8E93; margin: 32rpx 8rpx 14rpx; letter-spacing: 0.3rpx; }

.group {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 1rpx 2rpx rgba(0,0,0,0.03), 0 8rpx 24rpx rgba(0,0,0,0.05);
}

.row-info { display: flex; align-items: flex-start; gap: 20rpx; padding: 26rpx 24rpx; }
.row-text { display: flex; flex-direction: column; min-width: 0; flex: 1; }
.row-title { font-size: 30rpx; color: #1C1C1E; font-weight: 500; }
.row-sub { font-size: 24rpx; color: #8E8E93; margin-top: 6rpx; line-height: 1.5; }

.mi { display: flex; align-items: center; padding: 22rpx 24rpx; position: relative; }
.mi + .mi::before {
  content: '';
  position: absolute;
  left: 100rpx;
  right: 0;
  top: 0;
  height: 1rpx;
  background: #E5E5EA;
}
.mi-hover { background: rgba(0,0,0,0.04); }
.mt { flex: 1; font-size: 30rpx; color: #1C1C1E; }
.mi.danger .mt { color: #FF453A; }
.mr { font-size: 24rpx; color: #8E8E93; margin-left: 8rpx; }

.group-footer {
  display: block;
  font-size: 24rpx;
  color: #8E8E93;
  line-height: 1.5;
  margin: 14rpx 20rpx 0;
}
.group-footer.danger-text { color: #FF453A; }

.ic {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
  position: relative;
}

/* original CSS-drawn glyphs */
.ic-data { background: #5AC8FA; }
.ic-data::before { content: ''; width: 24rpx; height: 3rpx; background: #fff; border-radius: 2rpx; box-shadow: 0 8rpx 0 #fff, 0 -8rpx 0 #fff; }

.ic-exp { background: #34C759; }
.ic-exp::before { content: ''; position: absolute; bottom: 15rpx; left: 50%; transform: translateX(-50%); width: 3rpx; height: 15rpx; background: #fff; border-radius: 2rpx; }
.ic-exp::after { content: ''; position: absolute; top: 15rpx; left: 50%; margin-left: -6rpx; width: 12rpx; height: 12rpx; border-top: 3rpx solid #fff; border-left: 3rpx solid #fff; transform: rotate(45deg); }

.ic-clr { background: #FF453A; }
.ic-clr::before { content: ''; width: 18rpx; height: 18rpx; background: #fff; border-radius: 3rpx 3rpx 6rpx 6rpx; }
.ic-clr::after { content: ''; position: absolute; top: 14rpx; left: 50%; transform: translateX(-50%); width: 26rpx; height: 3rpx; background: #fff; border-radius: 2rpx; }
