<view class="container theme-{{themeKey}}">
  <view class="header">我的训练计划</view>
  <view class="form-card">
    <view class="form-title">{{editing ? '编辑训练计划' : '新建训练计划'}}</view>
    <input class="field" placeholder="计划名称，如：我的减脂训练" value="{{form.name}}" data-field="name" bindinput="onFieldInput" maxlength="20" />
    <view class="field-label">训练日（每周）</view>
    <view class="weekday-wrap">
      <view class="weekday-btn {{item.on ? 'on' : ''}}" wx:for="{{weekdayButtons}}" wx:key="key" bindtap="toggleWeekday" data-k="{{item.key}}">{{item.label}}</view>
    </view>
    <textarea class="plan-content" placeholder="填写训练内容，可按行输入&#10;例如：&#10;快走 30 分钟&#10;深蹲 3 组 × 12 次" value="{{form.content}}" data-field="content" bindinput="onFieldInput" maxlength="500" auto-height="true" />
    <view class="form-actions">
      <button class="btn-secondary" wx:if="{{editing}}" bindtap="cancelEdit">取消</button>
      <button class="btn-primary" bindtap="savePlan">保存</button>
    </view>
  </view>

  <view class="section-head">
    <text class="section-title">我的计划</text>
    <text class="section-tip">可随时编辑</text>
  </view>
  <view class="plans" wx:if="{{customPlans.length}}">
    <view class="pl-card" wx:for="{{customPlans}}" wx:key="id" bindtap="pickCustom" data-id="{{item.id}}">
      <view class="pl-main"><text class="pl-name">{{item.name}}</text><text class="pl-meta">自定义 · {{item.weekdayText}}</text></view>
      <view class="pl-actions">
        <text catchtap="editPlan" data-id="{{item.id}}">编辑</text>
        <text class="delete" catchtap="deletePlan" data-id="{{item.id}}">删除</text>
      </view>
    </view>
  </view>
  <view class="pl-empty" wx:else>还没有自定义计划，先创建一份适合自己的训练安排吧</view>

  <view class="card detail-card" wx:if="{{current}}">
    <view class="detail-title">{{current.name}}</view>
    <view class="detail-week" wx:if="{{current.weekdayText}}">{{current.weekdayText}}</view>
    <view class="day-list"><view class="day-item" wx:for="{{current.days}}" wx:key="day"><text class="day">{{item.day}}</text><view class="ex-item" wx:for="{{item.exercises}}" wx:key="*this"><text class="dot">•</text><text>{{item}}</text></view></view></view>
    <view class="action-row"><button class="btn-primary" bindtap="startToday">完成今日训练</button></view>
  </view>
</view>
