.streak-card { background: linear-gradient(135deg, #3A7D44, #6DB33F); border-radius: 24rpx; padding: 32rpx; color: #fff; text-align: center; margin-bottom: 24rpx; }
.streak-num { font-size: 72rpx; font-weight: 700; display: block; }
.streak-lbl { font-size: 24rpx; opacity: 0.9; display: block; margin-top: 4rpx; margin-bottom: 20rpx; }
.btn-primary { background: #fff; color: #3A7D44; border-radius: 40rpx; font-size: 28rpx; height: 68rpx; line-height: 68rpx; }
.section-title { font-size: 26rpx; font-weight: 600; color: #333; margin-bottom: 12rpx; }
.ach-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}
.ach {
  min-height: 188rpx;
  padding: 24rpx 22rpx 22rpx;
  box-sizing: border-box;
  background: rgba(255,255,255,.96);
  border: 1rpx solid rgba(229,229,234,.88);
  border-radius: 24rpx;
  box-shadow: 0 3rpx 12rpx rgba(28,28,30,.05);
  position: relative;
  overflow: hidden;
}
.ach.on { background: #FFF8E9; border-color: #F5DFB1; }
.ach-icon { display:block; height:48rpx; font-size:44rpx; line-height:48rpx; }
.ach-name { font-size:27rpx; font-weight:700; color:#1C1C1E; display:block; margin-top:14rpx; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.ach-desc { font-size:21rpx; color:#8E8E93; line-height:1.4; margin-top:6rpx; display:block; }
.ach-badge { position:absolute; top:18rpx; right:16rpx; padding:4rpx 10rpx; border-radius:12rpx; color:#8E8E93; background:#F2F2F7; font-size:19rpx; line-height:1.2; }
.action-row { display: flex; justify-content: center; }
.action-row .btn-primary { width: auto; min-width: 132rpx; height: 56rpx; line-height: 56rpx; margin: 0; padding: 0 28rpx; border: none; border-radius: 16rpx; background: rgba(255,255,255,.94); color: var(--accent-dark); font-size: 25rpx; font-weight: 600; }
/* Secondary completion action aligns with the card's trailing edge. */
.action-row { justify-content: flex-end; }