<view class="container theme-{{themeKey}}"><view class="header">打卡与成就</view><view class="streak-card"><text class="streak-num">{{streak}}</text><text class="streak-lbl">连续打卡天数</text><view class="action-row"><button class="btn-primary" bindtap="checkin">今日打卡</button></view></view><view class="section-title">成就徽章</view><view class="ach-grid"><view class="ach {{item.unlocked?'on':''}}" wx:for="{{achievements}}" wx:key="id"><text class="ach-icon">{{item.icon}}</text><text class="ach-name">{{item.name}}</text><text class="ach-desc">{{item.desc}}</text><text class="ach-badge" wx:if="{{!item.unlocked}}">未解锁</text></view></view></view>
