<view class="container theme-{{themeKey}}" wx:if="{{recipe}}"><view class="header-img"><text class="big-emoji">🍽</text><text class="r-name">{{recipe.name}}</text><view class="r-tags"><text class="rt" wx:for="{{recipe.tags}}" wx:key="*this">{{item}}</text></view></view><view class="card"><view class="title">营养成分</view><view class="nutri"><view class="n"><text class="nv">{{recipe.kcal}}</text><text class="nl">kcal</text></view><view class="n"><text class="nv">{{recipe.protein}}</text><text class="nl">蛋白质 g</text></view><view class="n"><text class="nv">{{recipe.fat}}</text><text class="nl">脂肪 g</text></view><view class="n"><text class="nv">{{recipe.carbs}}</text><text class="nl">碳水 g</text></view></view></view><view class="card"><view class="title">食材清单</view><view class="ing" wx:for="{{recipe.ingredients}}" wx:key="*this"><text class="dot">•</text><text>{{item}}</text></view></view><view class="card"><view class="title">制作步骤</view><view class="step" wx:for="{{recipe.steps}}" wx:key="*this"><text class="sn">{{index+1}}</text><text>{{item}}</text></view></view><view class="btn-row"><button class="btn-primary" bindtap="addMealPlan">加入每日食谱</button><button class="btn-secondary" bindtap="toggleFav">{{favorited ? '取消收藏' : '收藏'}}</button></view></view><view class="placeholder" wx:else>加载中...</view>
