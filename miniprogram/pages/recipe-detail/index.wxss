.header-img { background: linear-gradient(135deg, #3A7D44, #6DB33F); border-radius: 24rpx; padding: 40rpx 28rpx; color: #fff; text-align: center; margin-bottom: 20rpx; }
.big-emoji { font-size: 80rpx; display: block; }
.r-name { font-size: 36rpx; font-weight: 700; display: block; margin-top: 12rpx; }
.r-tags { margin-top: 12rpx; display: flex; gap: 8rpx; justify-content: center; flex-wrap: wrap; }
.rt { font-size: 22rpx; background: rgba(255,255,255,0.2); padding: 4rpx 14rpx; border-radius: 10rpx; }
.title { font-size: 28rpx; font-weight: 600; color: #333; margin-bottom: 12rpx; }
.nutri { display: flex; justify-content: space-around; }
.n { text-align: center; }
.nv { font-size: 32rpx; font-weight: 700; color: #1F4D2A; display: block; }
.nl { font-size: 20rpx; color: #999; margin-top: 4rpx; }
.ing, .step { display: flex; align-items: center; padding: 10rpx 0; font-size: 26rpx; color: #555; }
.dot { color: #6DB33F; margin-right: 12rpx; font-size: 18rpx; }
.sn { font-size: 24rpx; font-weight: 700; color: #3A7D44; width: 40rpx; margin-right: 16rpx; }
.btn-row { display: flex; gap: 16rpx; margin-top: 24rpx; }
.btn-row button { flex: 1; height: 72rpx; line-height: 72rpx; font-size: 28rpx; border-radius: 40rpx; }
.btn-secondary { background: #fff; color: #3A7D44; border: 1rpx solid #3A7D44; }
/* Two related actions are compact, content-width controls instead of broad bars. */
.btn-row { justify-content: center; }
.btn-row button { flex: none; width: auto; height: 58rpx; line-height: 58rpx; padding: 0 24rpx; border-radius: 16rpx; font-size: 25rpx; }
.btn-row .btn-primary { background: var(--accent-dark); }
.btn-row .btn-secondary { color: var(--accent-dark); border-color: var(--accent); }
/* Paired recipe actions sit at the trailing edge and stay compact. */
.btn-row { justify-content: flex-end; }